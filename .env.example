# ---------------------------------------------------------------------------
# Semantic RAG Search — environment configuration
# Copy this file to `.env` and fill in the required values:
#   cp .env.example .env
# `.env` is git-ignored, so your real key never gets committed.
# ---------------------------------------------------------------------------

# REQUIRED — Groq API key used for query rewriting, document grading,
# answer generation and RAGAS evaluation. Get a free key at:
#   https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# OPTIONAL — LLM used across the RAG pipeline.
# Defaults to llama-3.3-70b-versatile (Groq free tier).
# RAG_LLM_MODEL=llama-3.3-70b-versatile

# OPTIONAL — Max tokens for generated answers. Defaults to 4096.
# RAG_MAX_TOKENS=4096
